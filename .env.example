# Express 백엔드 서버 포트
PORT=5000

# Supabase PostgreSQL 연결 URL (Transaction Pooler 6543 포트)
DATABASE_URL=postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Supabase 프로젝트 URL 및 Anon Key
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# 카카오 REST API 키
KAKAO_API_KEY=your_kakao_rest_api_key_here