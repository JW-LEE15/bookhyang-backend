# Express 서버 포트 (비워 두면 5000, Render는 PORT를 자동으로 제공)
PORT=

# PostgreSQL(Supabase) 연결 URL
DATABASE_URL=

# 로그인 토큰 서명용 비밀값
JWT_SECRET=

# 카카오 REST API 키
KAKAO_API_KEY=

# 앞단 프록시(Render 등) 단계 수. IP 기준 횟수 제한이 실제 사용자 IP를 보게 한다.
# 비워 두거나 0이면 설정하지 않는다(로컬 개발). 배포 환경에서 실측해서 정한다. (0~10의 정수)
TRUST_PROXY_HOPS=
