# Express 서버 포트 (비워 두면 5000, Render는 PORT를 자동으로 제공)
PORT=

# PostgreSQL(Supabase) 연결 URL
DATABASE_URL=

# 로그인 토큰 서명용 비밀값
JWT_SECRET=

# 카카오 REST API 키
KAKAO_API_KEY=

# --- AI 추천 ---
# GEMINI_API_KEY나 AI_MODEL이 없어도 서버는 시작하고, AI 라우트만 503 AI_UNAVAILABLE로 응답한다.
# Google AI Studio에서 발급한 Gemini API 키 (비밀값)
GEMINI_API_KEY=
# 기본 모델 이름
AI_MODEL=
# 대체 모델 이름. 기본 모델이 404/503/429로 실패하면 요청당 한 번만 시도한다. 비우면 대체 없음.
AI_FALLBACK_MODEL=
# 아래는 필요할 때만 주석을 풀어 설정한다. (설정하지 않았을 때의 기본값을 적어 둠)
# 생각 수준(minimal | low | medium | high). 설정하지 않으면 minimal, 값을 비워 두면 thinkingConfig를 보내지 않는다.
# AI_THINKING_LEVEL=minimal
# 기본 호출과 대체 호출을 합친 전체 시간 예산(밀리초)
# AI_TIMEOUT_MS=20000
# 서버 전체 하루 호출 한도. 이 값의 90%에 닿으면 AI_BUSY로 응답한다. (하루의 기준은 태평양시)
# AI_DAILY_LIMIT=500
# 후보 책 개수 상한(1~20). 후보 부족(422) 로컬 확인용 테스트 값이며 운영에서는 설정하지 않는다.
# AI_CANDIDATE_LIMIT=20

# 앞단 프록시(Render 등) 단계 수. IP 기준 횟수 제한이 실제 사용자 IP를 보게 한다.
# 비워 두거나 0이면 설정하지 않는다(로컬 개발). 배포 환경에서 실측해서 정한다. (0~10의 정수)
TRUST_PROXY_HOPS=
